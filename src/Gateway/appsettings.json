{
  "ReverseProxy": {
    "Routes": {
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "invoices-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/invoices/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5254"
          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:PORTA_DO_BILLING"
          }
        }
      }
    }
  }
}
